# Provider-agnostic LLM client config -- the agent only ever reads these three values plus
# LLM_NUM_CTX; swapping providers means changing env vars, not code.

# --- Option A: local Ollama (documented dev default) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b
# Ollama-specific context-window tuning, sent via extra_body. Leave UNSET for any other
# provider (Groq, Anthropic, ...) -- its mere presence is what decides whether that gets sent.
LLM_NUM_CTX=4096

# --- Option B: Groq (hosted/demo path) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile
# (leave LLM_NUM_CTX unset for Groq)

# --- Option C: Anthropic (future) ---
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5

DUCKDB_PATH=data/warehouse.duckdb
